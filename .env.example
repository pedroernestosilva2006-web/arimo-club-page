# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT

# Server-side Supabase configuration
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_PROJECT_ID=YOUR_PROJECT

# Server-only. Never prefix this variable with VITE_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key

# Canonical production URL used in invitation links.
APP_URL=https://your-domain.com
